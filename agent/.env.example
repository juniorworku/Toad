# API key with api.agents.read, api.agents.write and api.responses.write permissions.
OPENAI_API_KEY=sk-proj-...
# Your own OpenAI project ID (proj_...). Leave blank to use the key's default project.
OPENAI_PROJECT=
# Optional: IANA zone for the time Toad reports, e.g. America/New_York. Blank = system zone.
TOAD_TZ=
