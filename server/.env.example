# Settings read from the environment or .env in the working directory (start the engine from
# the repository root). scripts/setup.py copies this to ./.env with a new DEVICE_TOKEN.

# Required. Shared secret the phone sends when it connects (ws://HOST:8787/device?token=...).
DEVICE_TOKEN=

# fake: diagnostic text and test tones, no AI, no keys, no cost.
# openai: GPT-Live voice + the saved "Toad" agent. Paid: GPT-Live bills per open minute.
PROVIDER_MODE=fake
PORT=8787
DATA_DIR=./data
# IANA zone used when telling the models what time it is, and for quiet hours.
TIME_ZONE=Africa/Addis_Ababa
# 1: keep a voice session open while the phone is connected (paid per minute in openai mode).
# 0: open it on Talk, the wake phrase or a check-in, and close it after IDLE_CLOSE_SECONDS.
ALWAYS_LISTEN=1
IDLE_CLOSE_SECONDS=120

# For PROVIDER_MODE=openai. The key needs api.agents.read, api.agents.write and
# api.responses.write, on a paid tier. Never put it on the phone.
OPENAI_API_KEY=
# Optional: your own project id (proj_...).
OPENAI_PROJECT=
LIVE_URL=wss://api.openai.com/v1/live/sessions
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
# Saved "Toad" agent to reuse. Empty: the engine creates one from agent/toad-agent.json and
# keeps it in sync with that file.
TOAD_AGENT_ID=
# AGENT_DEFINITION=/app/agent/toad-agent.json   (defaults to agent/toad-agent.json in the repo)

# Your apps through Composio (Gmail, Calendar, Slack, ...). Platform project key (ak_...).
COMPOSIO_API_KEY=
# Stable Composio user ID for Toad's one owner; connections are stored under it.
COMPOSIO_USER_ID=toad-owner

# Calls when you're away, through AgentPhone (https://agentphone.ai). All three turn it on.
# Key: AgentPhone dashboard -> Settings -> API Keys. Outbound calls need a payment method.
AGENTPHONE_API_KEY=
# Toad's AgentPhone number (calls come from it) and your own phone, both E.164 (+14155551234).
AGENTPHONE_NUMBER=
OWNER_PHONE=
# Call if a spoken check-in gets no reply for this long (or right away if the phone is offline).
AWAY_CALL_AFTER_SECONDS=60
# Local hours when Toad never calls on its own (start-end, 24h). Anything else turns it off.
QUIET_HOURS=22-8
