# Settings read from the environment or .env in the working directory.
# DEVICE_TOKEN is required; use a new random secret.
PROVIDER_MODE=fake
PORT=8787
DATA_DIR=./data
TIME_ZONE=Africa/Addis_Ababa
DEVICE_TOKEN=
ALWAYS_LISTEN=1
IDLE_CLOSE_SECONDS=120
# Opt-in live provider; account access must be verified.
OPENAI_API_KEY=
OPENAI_PROJECT=
LIVE_URL=wss://api.openai.com/v1/live/sessions
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin
TOAD_AGENT_ID=
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=toad-owner
AGENTPHONE_API_KEY=
AGENTPHONE_NUMBER=
OWNER_PHONE=
AWAY_CALL_AFTER_SECONDS=60
QUIET_HOURS=22-8
